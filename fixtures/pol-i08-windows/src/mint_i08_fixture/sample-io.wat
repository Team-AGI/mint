(module
  (import "wasi_snapshot_preview1" "path_open" (func $open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 32) "sample.txt")
  (data (i32.const 64) "lab!")
  (func (export "access") (param $preopen i32) (param $write_mode i32) (result i32)
    (local $err i32) (local $fd i32)
    (local.set $err (call $open (local.get $preopen) (i32.const 0) (i32.const 32) (i32.const 10)
      (i32.const 0) (if (result i64) (local.get $write_mode) (then (i64.const 64)) (else (i64.const 2)))
      (i64.const 0) (i32.const 0) (i32.const 0)))
    (if (local.get $err) (then (return (local.get $err))))
    (local.set $fd (i32.load (i32.const 0)))
    (i32.store (i32.const 8) (if (result i32) (local.get $write_mode) (then (i32.const 64)) (else (i32.const 128))))
    (i32.store (i32.const 12) (i32.const 4))
    (local.set $err (if (result i32) (local.get $write_mode)
      (then (call $write (local.get $fd) (i32.const 8) (i32.const 1) (i32.const 16)))
      (else (call $read (local.get $fd) (i32.const 8) (i32.const 1) (i32.const 16)))))
    (drop (call $close (local.get $fd)))
    (local.get $err)))
